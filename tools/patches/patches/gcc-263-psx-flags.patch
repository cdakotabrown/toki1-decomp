+/* Precompute all register parameters of ARGS (NUM_ACTUALS entries) into
+   pseudos or constants; set *REG_PARM_SEEN if any exist.  Factored out of
+   expand_call so that -fstack-args-first can run it after the stack
+   arguments have been stored.  */
+
+static void
+precompute_register_parameters (num_actuals, args, reg_parm_seen_p)
+     int num_actuals;
+     struct arg_data *args;
+     int *reg_parm_seen_p;
+{
+  int i;
+  int reg_parm_seen = 0;
+
+  for (i = 0; i < num_actuals; i++)
+    if (args[i].reg != 0 && ! args[i].pass_on_stack)
+      {
+	reg_parm_seen = 1;
+
+	if (args[i].value == 0)
+	  {
+	    push_temp_slots ();
+	    args[i].value = expand_expr (args[i].tree_value, NULL_RTX,
+					 VOIDmode, 0);
+	    preserve_temp_slots (args[i].value);
+	    pop_temp_slots ();
+
+	    /* ANSI doesn't require a sequence point here,
+	       but PCC has one, so this will avoid some problems.  */
+	    emit_queue ();
+	  }
+
+	/* If we are to promote the function arg to a wider mode,
+	   do it now.  */
+
+	if (args[i].mode != TYPE_MODE (TREE_TYPE (args[i].tree_value)))
+	  args[i].value
+	    = convert_modes (args[i].mode,
+			     TYPE_MODE (TREE_TYPE (args[i].tree_value)),
+			     args[i].value, args[i].unsignedp);
+
+	/* If the value is expensive, and we are inside an appropriately 
+	   short loop, put the value into a pseudo and then put the pseudo
+	   into the hard reg.
+
+	   For small register classes, also do this if this call uses
+	   register parameters.  This is to avoid reload conflicts while
+	   loading the parameters registers.  */
+
+	if ((! (GET_CODE (args[i].value) == REG
+		|| (GET_CODE (args[i].value) == SUBREG
+		    && GET_CODE (SUBREG_REG (args[i].value)) == REG)))
+	    && args[i].mode != BLKmode
+	    && rtx_cost (args[i].value, SET) > 2
+#ifdef SMALL_REGISTER_CLASSES
+	    && (reg_parm_seen || preserve_subexpressions_p ())
+#else
+	    && preserve_subexpressions_p ()
+#endif
+	    )
+	  args[i].value = copy_to_mode_reg (args[i].mode, args[i].value);
+      }
+
+  *reg_parm_seen_p = reg_parm_seen;
+}
