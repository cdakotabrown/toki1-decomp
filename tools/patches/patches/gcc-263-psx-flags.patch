+/* -fsched2-forward: after reload, re-order the insns of one scheduled
+   block with a FORWARD list scheduler over the same dependence graph
+   (LOG_LINKS) and the same MIPS unit model (insn_cost, function unit
+   blockage).  Each cycle the ready insn with the longest latency-weighted
+   path to the end of the block is issued; ties go first to an insn that is
+   data dependent on the insn issued last, then to the original (pre-sched2)
+   order.  An insn is ready when every predecessor has issued and its
+   latency has elapsed and its function units are free; when nothing is
+   ready the clock advances (the stall is left to the assembler).  This is
+   the order retail Psy-Q library objects show (CdIntToPos, CdIntToPos).
+   Blocks containing SCHED_GROUP_P insns or interior notes are left in
+   the backward scheduler's order.  */
+
+static void
+schedule_block_forward (prev_head, next_tail, file)
+     rtx prev_head, next_tail;
+     FILE *file;
+{
+  rtx insn, link, first_insn = 0, last_insn;
+  rtx *v;
+  int *pri, *issued, *npred;
+  int n = 0, i, j, k, clock, nsched;
+  int max_uid = get_max_uid ();
+  int *idx;
+  rtx unit_last[FUNCTION_UNITS_SIZE];
+  int unit_time[FUNCTION_UNITS_SIZE];
+  rtx last_issued = 0;
+
+  for (insn = NEXT_INSN (prev_head); insn != next_tail; insn = NEXT_INSN (insn))
+    {
+      if (GET_RTX_CLASS (GET_CODE (insn)) == 'i')
+	{
+	  if (SCHED_GROUP_P (insn))
+	    return;
+	  if (first_insn == 0)
+	    first_insn = insn;
+	  n++;
+	}
+      else if (first_insn != 0)
+	return;			/* A note among the insns: leave the block.  */
+    }
+  if (n < 2)
+    return;
+
+  v = (rtx *) alloca (n * sizeof (rtx));
+  pri = (int *) alloca (n * sizeof (int));
+  issued = (int *) alloca (n * sizeof (int));
+  npred = (int *) alloca (n * sizeof (int));
+  idx = (int *) alloca ((max_uid + 1) * sizeof (int));
+  for (i = 0; i <= max_uid; i++)
+    idx[i] = -1;
+
+  /* V holds the insns in original (pre-sched2) order.  */
+  for (i = 0, insn = first_insn; insn != next_tail; insn = NEXT_INSN (insn))
+    v[i++] = insn;
+  for (i = 1; i < n; i++)
+    for (j = i; j > 0 && INSN_LUID (v[j - 1]) > INSN_LUID (v[j]); j--)
+      {
+	rtx t = v[j]; v[j] = v[j - 1]; v[j - 1] = t;
+      }
+  for (i = 0; i < n; i++)
+    idx[INSN_UID (v[i])] = i;
+
+  /* Priority: longest latency-weighted path to the end of the block.  */
+  for (i = n - 1; i >= 0; i--)
+    pri[i] = 0;
+  for (i = n - 1; i >= 0; i--)
+    for (link = LOG_LINKS (v[i]); link; link = XEXP (link, 1))
+      {
+	rtx p = XEXP (link, 0);
+	if (INSN_UID (p) <= max_uid && (j = idx[INSN_UID (p)]) >= 0
+	    && pri[i] + insn_cost (p, link, v[i]) > pri[j])
+	  pri[j] = pri[i] + insn_cost (p, link, v[i]);
+      }
+
+  for (i = 0; i < n; i++)
+    issued[i] = -1;
+  for (i = 0; i < FUNCTION_UNITS_SIZE; i++)
+    unit_last[i] = 0, unit_time[i] = 0;
+
+  /* Leading notes (moved to the head of the block) stay in front.  */
+  last_insn = PREV_INSN (first_insn);
+  for (clock = 0, nsched = 0; nsched < n; clock++)
+    {
+      int best = -1, best_dep = 0;
+
+      for (i = 0; i < n; i++)
+	{
+	  int ok = 1, dep = 0, u;
+
+	  if (issued[i] >= 0)
+	    continue;
+	  for (link = LOG_LINKS (v[i]); link && ok; link = XEXP (link, 1))
+	    {
+	      rtx p = XEXP (link, 0);
+	      if (INSN_UID (p) > max_uid || (j = idx[INSN_UID (p)]) < 0)
+		continue;
+	      if (issued[j] < 0
+		  || issued[j] + insn_cost (p, link, v[i]) > clock)
+		ok = 0;
+	      else if (p == last_issued && REG_NOTE_KIND (link) == 0)
+		dep = 1;
+	    }
+	  if (! ok)
+	    continue;
+
+	  /* Function unit blockage against the last insn on each unit.  */
+	  u = insn_unit (v[i]);
+	  for (k = 0; k < FUNCTION_UNITS_SIZE && ok; k++)
+	    if ((u >= 0 ? u == k : ((~u) >> k) & 1) && unit_last[k] != 0
+		&& unit_time[k]
+		   + (function_units[k].blockage_function
+		      ? (*function_units[k].blockage_function) (unit_last[k],
+							       v[i])
+		      : function_units[k].max_blockage) > clock)
+	      ok = 0;
+	  if (! ok)
+	    continue;
+
+	  if (best < 0 || pri[i] > pri[best]
+	      || (pri[i] == pri[best] && dep && ! best_dep))
+	    best = i, best_dep = dep;
+	}
+
+      if (best < 0)
+	continue;		/* Stall.  */
+
+      if (file)
+	fprintf (file, ";; forward: T%d insn %d (priority %d%s)\n", clock,
+		 INSN_UID (v[best]), pri[best], best_dep ? ", dep" : "");
+      issued[best] = clock;
+      last_issued = v[best];
+      {
+	int u = insn_unit (v[best]);
+	for (k = 0; k < FUNCTION_UNITS_SIZE; k++)
+	  if (u >= 0 ? u == k : ((~u) >> k) & 1)
+	    unit_last[k] = v[best], unit_time[k] = clock;
+      }
+      NEXT_INSN (last_insn) = v[best];
+      PREV_INSN (v[best]) = last_insn;
+      last_insn = v[best];
+      nsched++;
+    }
+  NEXT_INSN (last_insn) = next_tail;
+  PREV_INSN (next_tail) = last_insn;
+}
