	   "$(BUILD_DIR)/test/original_track2.bin"
	@echo "  Creating CUE file..."
	@echo 'FILE "original_track1.bin" BINARY' > $(BUILD_DIR)/test/original.cue
	@echo '  TRACK 01 MODE2/2352' >> $(BUILD_DIR)/test/original.cue
	@echo '    FLAGS DCP' >> $(BUILD_DIR)/test/original.cue
	@echo '    INDEX 01 00:00:00' >> $(BUILD_DIR)/test/original.cue
	@echo 'FILE "original_track2.bin" BINARY' >> $(BUILD_DIR)/test/original.cue
	@echo '  TRACK 02 AUDIO' >> $(BUILD_DIR)/test/original.cue
	@echo '    FLAGS DCP' >> $(BUILD_DIR)/test/original.cue
	@echo '    INDEX 00 00:00:00' >> $(BUILD_DIR)/test/original.cue
	@echo '    INDEX 01 00:02:00' >> $(BUILD_DIR)/test/original.cue
	@echo ""
	@echo "Test the ORIGINAL disc first to verify your disc image works!"
	@echo ""
	@echo "To test: open $(BUILD_DIR)/test/original.cue in a PS1 emulator"

# ═══════════════════════════════════════════════════════════════════════════════
# LEVEL 3 MATCHING TOOLS
# ═══════════════════════════════════════════════════════════════════════════════
# Tools for achieving byte-perfect (Level 3) function matches

# Verify a single function match
# Usage: make verify-func FUNC=func_8004B338
verify-func:
	@if [ -z "$(FUNC)" ]; then \
		echo "Usage: make verify-func FUNC=func_name"; \
		echo "Example: make verify-func FUNC=func_8004B338"; \
		exit 1; \
	fi
	$(PYTHON) $(TOOLS_DIR)/analysis/verify_match.py $(FUNC) --verbose

# Verify all decompiled functions
verify-all:
	$(PYTHON) $(TOOLS_DIR)/analysis/verify_match.py --all

# Quick diff for fast comparison
# Usage: make quick-diff FUNC=func_8004B338
quick-diff:
	@if [ -z "$(FUNC)" ]; then \
		echo "Usage: make quick-diff FUNC=func_name"; \
		echo "Example: make quick-diff FUNC=func_8004B338"; \
		exit 1; \
	fi
	$(PYTHON) $(TOOLS_DIR)/decomp/quick_diff.py $(FUNC)

# Extract original assembly for a function
# Usage: make extract-asm FUNC=func_8004B338
extract-asm:
	@if [ -z "$(FUNC)" ]; then \
		echo "Usage: make extract-asm FUNC=func_name"; \
		echo "Example: make extract-asm FUNC=func_8004B338"; \
		exit 1; \
	fi
	$(PYTHON) $(TOOLS_DIR)/analysis/extract_function_asm.py $(FUNC) --format annotated --verbose

# Extract assembly in m2c format (for decompilation)
# Usage: make extract-m2c FUNC=func_8004B338
extract-m2c:
	@if [ -z "$(FUNC)" ]; then \
		echo "Usage: make extract-m2c FUNC=func_name"; \
		exit 1; \
	fi
	$(PYTHON) $(TOOLS_DIR)/analysis/extract_function_asm.py $(FUNC) --format m2c --print

# Run decomp-permuter to find byte-perfect match
# Usage: make permute FUNC=func_8004B338 [ITERATIONS=10000]
ITERATIONS ?= 1000
permute:
	@if [ -z "$(FUNC)" ]; then \
		echo "Usage: make permute FUNC=func_name [ITERATIONS=10000]"; \
		echo "Example: make permute FUNC=func_8004B338 ITERATIONS=5000"; \
		exit 1; \
	fi
	$(PYTHON) $(TOOLS_DIR)/decomp/permute_function.py $(FUNC) --iterations $(ITERATIONS) --verbose

# Setup permuter environment without running
# Usage: make permute-setup FUNC=func_8004B338
permute-setup:
	@if [ -z "$(FUNC)" ]; then \
		echo "Usage: make permute-setup FUNC=func_name"; \
		exit 1; \
	fi
	$(PYTHON) $(TOOLS_DIR)/decomp/permute_function.py $(FUNC) --setup-only --show-base

# List leaf functions (easiest targets)
list-leaf:
	$(PYTHON) $(TOOLS_DIR)/analysis/extract_function_asm.py --list-leaf --limit 50

# List all functions by difficulty
list-functions:
	$(PYTHON) $(TOOLS_DIR)/analysis/extract_function_asm.py --list-all --limit 100

# Full matching workflow for a function
# Usage: make match-workflow FUNC=func_8004B338
match-workflow:
	@if [ -z "$(FUNC)" ]; then \
		echo "Usage: make match-workflow FUNC=func_name"; \
		exit 1; \
	fi
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   MATCHING WORKFLOW FOR $(FUNC)"
	@echo "════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "Step 1: Extracting original assembly..."
	@echo ""
	$(PYTHON) $(TOOLS_DIR)/analysis/extract_function_asm.py $(FUNC) --format annotated --verbose
	@echo ""
	@echo "Step 2: Running quick diff..."
	@echo ""
	-$(PYTHON) $(TOOLS_DIR)/decomp/quick_diff.py $(FUNC) || true
	@echo ""
	@echo "Step 3: Full verification..."
	@echo ""
	-$(PYTHON) $(TOOLS_DIR)/analysis/verify_match.py $(FUNC) --verbose || true
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   WORKFLOW COMPLETE"
	@echo "════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "Next steps:"
	@echo "  1. Edit the C source file based on diff output"
	@echo "  2. Run: make test-decomp (verify it compiles)"
	@echo "  3. Run: make quick-diff FUNC=$(FUNC) (check changes)"
	@echo "  4. If close but not matching:"
	@echo "     Run: make permute FUNC=$(FUNC) ITERATIONS=5000"
	@echo "  5. Once matching:"
	@echo "     Run: make patch-disc (test in emulator)"
	@echo ""
	@echo "See docs/reference/MATCHING-TRICKS.md for common techniques."
# Verify all functions against the game binary
verify-functions:
	@echo "Verifying all functions against game binary..."
	$(PYTHON) $(TOOLS_DIR)/analysis/verify_functions.py
	@echo ""
	@echo "For detailed output: $(PYTHON) $(TOOLS_DIR)/analysis/verify_functions.py --verbose"
	@echo "For JSON export:     $(PYTHON) $(TOOLS_DIR)/analysis/verify_functions.py --output build/verification.json"
	@echo "For single function: $(PYTHON) $(TOOLS_DIR)/analysis/verify_functions.py -f func_name -v"

# ═══════════════════════════════════════════════════════════════════════════════
# LEVEL 3 BUILD (Byte-Perfect Matched Functions)
# ═══════════════════════════════════════════════════════════════════════════════

LEVEL3_CONFIG := config/level3_functions.json
LEVEL3_BIN := $(BUILD_DIR)/level3/SLPS_000.65

# Build with Level 3 matched functions
build-level3: $(VENV_DIR)
	@echo "Building with Level 3 matched functions..."
	$(PYTHON) $(TOOLS_DIR)/build/build_level3.py --verbose

# Verify Level 3 build matches original
check-level3: build-level3
	@echo ""
	@echo "Verifying Level 3 build..."
	@LEVEL3_SHA1=$$(sha1sum $(LEVEL3_BIN) | awk '{print $$1}'); \
	ORIG_SHA1=$$(sha1sum $(ORIGINAL_BIN) | awk '{print $$1}'); \
	echo "Original SHA1: $$ORIG_SHA1"; \
	echo "Level 3 SHA1:  $$LEVEL3_SHA1"; \
	if [ "$$LEVEL3_SHA1" = "$$ORIG_SHA1" ]; then \
		echo ""; \
		echo "✓ SUCCESS! Level 3 build matches original!"; \
	else \
		echo ""; \
		echo "✗ SHA1 mismatch - some functions don't match perfectly"; \
		exit 1; \
	fi

# Patch disc with Level 3 build
patch-disc-level3: build-level3
	@echo "Patching disc with Level 3 build..."
	@mkdir -p $(BUILD_DIR)
	@cp "$(DISC_IMAGE)" "$(BUILD_DIR)/tokimeki_level3_track1.bin"
	@$(PYTHON) tools/disc/patch_cdrom.py \
		--track "$(BUILD_DIR)/tokimeki_level3_track1.bin" \
		--exe $(LEVEL3_BIN) \
		--start-sector $(EXE_START_SECTOR)
	@cp "disks/Tokimeki Memorial - Forever with You (Japan) (Rev 1) (Track 2).bin" \
	   "$(BUILD_DIR)/tokimeki_level3_track2.bin"
	@echo 'FILE "tokimeki_level3_track1.bin" BINARY' > $(BUILD_DIR)/tokimeki_level3.cue
	@echo '  TRACK 01 MODE2/2352' >> $(BUILD_DIR)/tokimeki_level3.cue
	@echo '    INDEX 01 00:00:00' >> $(BUILD_DIR)/tokimeki_level3.cue
	@echo 'FILE "tokimeki_level3_track2.bin" BINARY' >> $(BUILD_DIR)/tokimeki_level3.cue
	@echo '  TRACK 02 AUDIO' >> $(BUILD_DIR)/tokimeki_level3.cue
	@echo '    INDEX 00 00:00:00' >> $(BUILD_DIR)/tokimeki_level3.cue
	@echo '    INDEX 01 00:02:00' >> $(BUILD_DIR)/tokimeki_level3.cue
	@echo ""
	@echo "Level 3 disc created: $(BUILD_DIR)/tokimeki_level3.cue"
	@echo "Test: open $(BUILD_DIR)/tokimeki_level3.cue in a PS1 emulator"

# Show Level 3 progress
level3-status:
	@echo "Level 3 (Byte-Perfect) Function Status"
	@echo "========================================"
	@$(PYTHON) -c "import json; config = json.load(open('$(LEVEL3_CONFIG)')); funcs = config.get('functions', []); print(f'Matched functions: {len(funcs)}'); total_bytes = sum(f['size'] for f in funcs); print(f'Total bytes: {total_bytes:,}'); print(); [print(f\"  {f['name']}: {f['size']} bytes ({f.get('type', 'unknown')})\") for f in funcs]"

# ============================================
# Thunk Detection and Generation Targets
# ============================================
# For handling "hidden register" patterns where code before the prologue
# sets up t-registers (t6, t7, etc.) that the function uses.

THUNK_JSON := build/thunks.json
THUNK_STUBS_DIR := asm/thunks
THUNK_METADATA := build/thunk_stub_metadata.json
THUNK_LINK_ORDER := build/thunk_link_order.txt
THUNK_BOUNDARIES := build/thunk_boundary_adjustments.json

# Detect thunks in the binary (run once, then manually review)
detect-thunks: $(THUNK_JSON)
$(THUNK_JSON): disks/SLPS_000.65
	@echo "Detecting thunk patterns..."
	$(PYTHON) tools/analysis/detect_thunks.py \
		--output $@ \
		--verify-calls \
		--verbose

# Generate thunk boundary adjustments and symbol overrides
thunk-boundaries: $(THUNK_JSON)
	@echo "Generating boundary adjustments..."
	$(PYTHON) tools/analysis/adjust_thunk_boundaries.py \
		--thunks $(THUNK_JSON) \
		--output $(THUNK_BOUNDARIES) \
		--symbol-overrides build/thunk_symbol_overrides.txt

# Generate thunk ASM stubs (fallthrough mode for byte-identical)
thunk-stubs: $(THUNK_JSON)
	@echo "Generating thunk ASM stubs..."
	@mkdir -p $(THUNK_STUBS_DIR)
	$(PYTHON) tools/analysis/generate_thunk_stubs.py \
		--thunks $(THUNK_JSON) \
		--output-dir $(THUNK_STUBS_DIR) \
		--metadata-out $(THUNK_METADATA) \
		--mode fallthrough

# Generate thunk stubs with jump mode (safer but not byte-identical)
thunk-stubs-jump: $(THUNK_JSON)
	@echo "Generating thunk ASM stubs (jump mode)..."
	@mkdir -p $(THUNK_STUBS_DIR)
	$(PYTHON) tools/analysis/generate_thunk_stubs.py \
		--thunks $(THUNK_JSON) \
		--output-dir $(THUNK_STUBS_DIR) \
		--metadata-out $(THUNK_METADATA) \
		--mode jump

# Generate linker ordering helpers
thunk-linker: $(THUNK_METADATA)
	@echo "Generating linker ordering..."
	$(PYTHON) tools/build/generate_thunk_linker_snippet.py \
		--metadata $(THUNK_METADATA) \
		--link-order $(THUNK_LINK_ORDER)

# Verify thunk placement (addresses continuous, no overlaps)
verify-thunks: $(THUNK_METADATA)
	@echo "Verifying thunk placement..."
	$(PYTHON) tools/build/verify_thunk_placement.py \
		--metadata $(THUNK_METADATA) \
		--exe disks/SLPS_000.65 \
		--strict

# Full thunk pipeline (detect -> boundaries -> stubs -> linker -> verify)
thunks: detect-thunks thunk-boundaries thunk-stubs thunk-linker verify-thunks
	@echo ""
	@echo "Thunk pipeline complete!"
	@echo "Generated files:"
	@echo "  $(THUNK_JSON)"
	@echo "  $(THUNK_BOUNDARIES)"
	@echo "  $(THUNK_METADATA)"
	@echo "  $(THUNK_LINK_ORDER)"
	@echo "  $(THUNK_STUBS_DIR)/*.s"

# Show thunk summary
thunk-status:
	@if [ -f $(THUNK_JSON) ]; then \
		$(PYTHON) -c "import json; d=json.load(open('$(THUNK_JSON)')); \
			t=d.get('thunks',{}); \
			tc=len(t.get('thunk_called',[])); \
			bc=len(t.get('both_called',[])); \
			fc=len(t.get('function_called',[])); \
			print(f'Thunk patterns detected:'); \
			print(f'  Thunk-only called: {tc}'); \
			print(f'  Both called: {bc}'); \
			print(f'  Function-only called: {fc}'); \
			print(f'  Total potential thunks: {tc + bc}')"; \
	else \
		echo "No thunks.json found. Run 'make detect-thunks' first."; \
	fi

# Clean thunk artifacts
clean-thunks:
	rm -rf $(THUNK_STUBS_DIR)
	rm -f build/thunk_*.json build/thunk_*.txt build/thunk_*.ld build/thunk_*.md

.PHONY: detect-thunks thunk-boundaries thunk-stubs thunk-stubs-jump thunk-linker verify-thunks thunks thunk-status clean-thunks

# ════════════════════════════════════════════════════════════════════════════
# OVERLAY BUILD TARGETS
# ════════════════════════════════════════════════════════════════════════════

# Fix C89 compatibility issues in overlay C source
overlay-fix-c89:
	python3 tools/overlay/fix_c89_labels.py --all
	python3 tools/overlay/fix_c89_decls.py --all

# Generate overlay symbol maps from EXN binaries
overlay-symbols:
	python3 tools/overlay/extract_symbols.py --all

# Generate overlay linker scripts
overlay-linkers: overlay-symbols
	python3 tools/overlay/generate_linker.py --all

# Build a single overlay (usage: make build-overlay-OPTION)
build-overlay-%: overlay-linkers
	python3 tools/overlay/build_overlay.py $*

# Build all overlays (runs C89 fixes first)
build-overlays: overlay-fix-c89 overlay-linkers
	python3 tools/overlay/build_overlay.py --all

# Verify overlay functions at byte level (not just instruction count)
verify-overlay-bytes:
	python3 tools/overlay/verify_overlay_bytes.py --all

# Verify single overlay at byte level
verify-overlay-bytes-%:
	python3 tools/overlay/verify_overlay_bytes.py $*

# Show overlay byte-match status summary
overlay-byte-status:
	python3 tools/overlay/verify_overlay_bytes.py --summary

# Test single overlay function byte match
test-overlay-match:
	@echo "Usage: make test-overlay-match OVERLAY=GEKO FUNC=func_80132244"
	@if [ -n "$(OVERLAY)" ] && [ -n "$(FUNC)" ]; then \
		python3 tools/overlay/test_overlay_match.py $(OVERLAY) $(FUNC) -v; \
	fi

# Byte-perfect verification (with relocation fixup)
verify-overlay-byte-perfect:
	python3 tools/overlay/verify_overlay_bytes.py --all --fix-relocs

# Single overlay byte-perfect verification
verify-overlay-byte-perfect-%:
	python3 tools/overlay/verify_overlay_bytes.py $* --fix-relocs

# Test single function with byte-perfect fixup
test-overlay-byte-perfect:
	@echo "Usage: make test-overlay-byte-perfect OVERLAY=GEKO FUNC=func_80132244"
	@if [ -n "$(OVERLAY)" ] && [ -n "$(FUNC)" ]; then \
		python3 tools/overlay/test_overlay_match.py $(OVERLAY) $(FUNC) -v --fix-relocs; \
	fi

# ═══════════════════════════════════════════════════════════════════════════════
# CLEAN BUILD TARGETS (source -> byte-perfect disk)
# ═══════════════════════════════════════════════════════════════════════════════

.PHONY: check-exn check-exn-all check-clean-main clean-iso clean-build-report

# Clean-build one overlay from SOURCE and gate on whole-file SHA1
check-exn:
	@if [ -z "$(OVERLAY)" ]; then \
		echo "Usage: make check-exn OVERLAY=RENSYU"; exit 1; \
	fi
	$(PYTHON) tools/overlay/build_clean_exn.py $(OVERLAY) --verify

# Clean-build ALL 26 overlays from SOURCE with SHA1 gates (cached; warm ~5s)
# Per-function overlay disassembly from the player's own disc (see
# asm/overlay/README.md). The 33 hand-authored exceptions stay tracked.
.PHONY: asm-overlays
asm-overlays:
	$(PYTHON) tools/overlay/emit_asm_overlays.py

# include/overlay_text/<OV>.h (also written by asm-overlays): the TXT_<ADDR>
# string literals the matched overlay C uses, read from the player's own EXN
# extraction (gitignored game text).
.PHONY: overlay-text
overlay-text:
	$(PYTHON) tools/overlay/gen_overlay_text.py

# The main binary's asm_only listings (asm/main/matched/*.s, gitignored):
# Sony LIBGTE members, BIOS thunks and the other assembly-by-origin windows,
# emitted byte-exact from the player's own SLPS_000.65. The coverage and
# function audits read them; the builds do not.
.PHONY: asm-main
asm-main:
	$(PYTHON) tools/analysis/emit_psyq_asm_only.py
	$(PYTHON) tools/analysis/emit_asm_only_window.py
	$(PYTHON) tools/analysis/gen_bios_thunk_asm.py
	$(PYTHON) tools/analysis/gen_b0508_asm.py

check-exn-all: asm-overlays
	$(PYTHON) tools/overlay/build_clean_exn.py --all --verify

# Overlays whose .rodata/.data/.bss region is built from source instead of
# copied from the EXN (tools/overlay/overlay_data_from_source.py).
DATA_FROM_SOURCE_OVERLAYS = RENSYU
.PHONY: check-exn-data
check-exn-data: asm-overlays
	$(PYTHON) tools/overlay/build_clean_exn.py $(DATA_FROM_SOURCE_OVERLAYS) --verify --data-from-source
	$(PYTHON) tools/overlay/test_overlay_data_from_source.py

# Clean-build the MAIN executable from SOURCE and gate on SHA1
check-clean-main:
	$(PYTHON) tools/build/build_clean_main.py --verify

# Assemble the full disc from clean-built EXNs + main exe and gate vs the dump
clean-iso: check-exn-all check-clean-main
	$(PYTHON) tools/iso/build_clean_iso.py --verify

# Tree-wide clean-build debt report (per-overlay %code-from-C + main + disc)
clean-build-report:
	$(PYTHON) tools/overlay/build_clean_exn.py --report

# ─── Ghidra comprehension oracle (read-only; NOT a byte-perfect matcher) ─────
.PHONY: ghidra-ping ghidra-test

# Health-check a running ghidra-mcp plugin (Tools > GhidraMCP > Start MCP Server).
# Then use: python3 tools/ghidra/cli.py decompile|disasm|xrefs|callers 0xADDR
ghidra-ping:
	$(PYTHON) tools/ghidra/cli.py ping

# Offline unit tests for the Ghidra client (no live Ghidra needed)
ghidra-test:
	$(PYTHON) tools/ghidra/cli.py --help >/dev/null
	$(PYTHON) tools/ghidra/test_ghidra_integration.py

# Targets of the other parts of the project (the PC port, the English patch)
# live in mk/*.mk, which exist only in a checkout that holds those parts:
# the decompilation's own targets never name them.
-include $(sort $(wildcard mk/*.mk))
