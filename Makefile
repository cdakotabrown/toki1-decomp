# Extract assets from original disc image
extract-assets:
	@echo "════════════════════════════════════════"
	@echo "   Extracting assets from disc image..."
	@echo "════════════════════════════════════════"
	@if [ ! -f "$(DISC_IMAGE)" ]; then \
		echo "ERROR: Disc image not found: $(DISC_IMAGE)"; \
		exit 1; \
	fi
	@mkdir -p $(EXTRACTED_ISO_DIR)
	cd $(EXTRACTED_ISO_DIR) && $(CURDIR)/$(DUMPSXISO) -x . -s layout.xml "$(CURDIR)/$(DISC_IMAGE)"
	@# the overlay EXNs are the compare targets of every overlay tool and the
	@# inputs of the clean builds (tools/overlay/*) and of the English patch build
	@mkdir -p assets/overlays
	cp -p $(EXTRACTED_ISO_DIR)/CDROM/EXEDIR/*.EXN assets/overlays/
	@echo ""
	@echo "════════════════════════════════════════"
	@echo "   Assets extracted to $(EXTRACTED_ISO_DIR)"
	@echo "════════════════════════════════════════"
	@echo ""
	@echo "Extracted files:"
	@ls -la $(EXTRACTED_ISO_DIR)/*.* 2>/dev/null || true
	@echo ""
	@echo "NOTE: Original disc has 303,031 unreferenced sectors containing"
	@echo "      most game assets (graphics, audio, etc.). The ISO9660"
	@echo "      filesystem only contains boot files and videos."
	@echo ""
	@echo "To extract ALL assets including unreferenced data:"
	@echo "  make extract-deep-assets"
	@echo ""
	@echo "To convert assets to usable formats (PNG, VAG):"
	@echo "  make convert-assets"

# Convert extracted assets to usable formats (TIM->PNG, VH/VB->VAG)
convert-assets: extract-assets $(VENV_DIR)
	@echo ""
	@echo "════════════════════════════════════════"
	@echo "   Converting assets to usable formats..."
	@echo "════════════════════════════════════════"
	@echo ""
	@$(VENV_DIR)/bin/pip install -q Pillow 2>/dev/null || true
	@$(PYTHON) $(TOOLS_DIR)/assets/batch_extract.py --quiet
	@echo ""
	@echo "Converted assets are in: assets/converted/"

# Extract ALL assets including unreferenced sectors (requires Java + jPSXdec)
extract-deep-assets: extract-assets
	@echo ""
	@echo "════════════════════════════════════════"
	@echo "   Deep Asset Extraction (jPSXdec)"
	@echo "════════════════════════════════════════"
	@echo ""
	@echo "This will extract ALL game assets from unreferenced CD sectors:"
	@echo "  - TIM graphics (character portraits, backgrounds)"
	@echo "  - VAB/SEQ audio (music, sound effects)"
	@echo "  - XA audio (voice, ambient sounds)"
	@echo "  - STR videos (additional movies)"
	@echo "  - TMD models (3D character/object models)"
	@echo ""
	@echo "Requirements:"
	@echo "  - Java 8 or higher (install: sudo apt install default-jre)"
	@echo "  - ~15 minutes extraction time"
	@echo "  - ~1 GB disk space for extracted assets"
	@echo ""
	@read -p "Continue? (y/N) " -n 1 -r; \
	echo ""; \
	if [[ ! $$REPLY =~ ^[Yy]$$ ]]; then \
		echo "Aborted."; \
		exit 1; \
	fi
	@bash $(TOOLS_DIR)/assets/extract_deep_assets.sh

