# QEMU-IRIX locations.  The source and build are fetched/built OUT OF TREE
# into build/, at a pinned upstream commit.  The rootfs is staged from the
# IRIX IDO 5.2 binaries in tools/ido-static-recomp/ido/5.2 (the recomp's
# inputs; the hooks live in the recompiled C, not in these files) -- no IRIX
# install media required.  Harness: tools/analysis/validate_ido52.py.
QEMU_IRIX_SRC    := build/qemu-irix-src
QEMU_IRIX_COMMIT := 6d7d1fde2f68adf795e51a19ad2572a48931884e
QEMU_IRIX_BUILD  := build/qemu-irix
QEMU_IRIX_BIN   := $(QEMU_IRIX_BUILD)/irix-linux-user/qemu-irix
IDO52_IRIX_TREE := $(TOOLS_DIR)/ido-static-recomp/ido/5.2
IRIX_ROOTFS     := build/irix52-rootfs

