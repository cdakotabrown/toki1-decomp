# Rebuild ISO with MODIFIED executable (after decompilation build succeeds)
rebuild-iso: $(TARGET_BIN) extract-assets
	@echo "════════════════════════════════════════"
	@echo "   Rebuilding ISO with modified executable..."
	@echo "════════════════════════════════════════"
	@echo "Copying modified executable..."
	cp $(TARGET_BIN) $(EXTRACTED_ISO_DIR)/SLPS_000.65
	@echo "Updating SYSTEM.CNF..."
	@printf "BOOT = cdrom:SLPS_000.65;1\nTCB = 8\nEVENT = 32\nSTACK = 801FFF00\n" > $(EXTRACTED_ISO_DIR)/SYSTEM.CNF
	@echo "Building ISO..."
	@mkdir -p $(BUILD_DIR)
	$(MKPSXISO) -y -o $(ISO_OUTPUT) -c $(CUE_OUTPUT) $(ISO_CONFIG)
	@echo ""
	@echo "════════════════════════════════════════"
	@echo "   ISO rebuilt with modified executable!"
	@echo "════════════════════════════════════════"
	@echo ""
	@echo "Output files:"
	@ls -la $(ISO_OUTPUT) $(CUE_OUTPUT)
	@echo ""
	@echo "To test in emulator:"
	@echo "  (open in a PS1 emulator) $(CUE_OUTPUT)"

