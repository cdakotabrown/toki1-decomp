# Setup assets - extract all game files from disc
setup-assets: $(VENV_DIR) validate-disc
	@if [ -d "$(EXTRACTED_ISO_DIR)" ] && [ "$$(find $(EXTRACTED_ISO_DIR) -type f 2>/dev/null | wc -l)" -gt 100 ]; then \
		echo "✓ Assets already extracted: $(EXTRACTED_ISO_DIR) ($$(find $(EXTRACTED_ISO_DIR) -type f | wc -l) files)"; \
	else \
		echo "Extracting game assets from disc image..."; \
		$(MAKE) extract-assets; \
		echo ""; \
		echo "✓ Assets extracted to $(EXTRACTED_ISO_DIR)"; \
		echo "  Files: $$(find $(EXTRACTED_ISO_DIR) -type f | wc -l)"; \
		echo ""; \
		echo "Asset types extracted:"; \
		echo "  .BIN  - Game data files (graphics, levels, packed data)"; \
		echo "  .VH/.VB - VAB audio (headers + bodies)"; \
		echo "  .SEQ  - Music sequences (MIDI-like)"; \
		echo "  .TMD  - 3D models"; \
		echo "  .XA   - CD-XA audio (voices, ambience)"; \
		echo "  .STR  - Video streams (FMV)"; \
		echo "  .TIM  - Textures"; \
	fi

# Setup Python virtual environment
setup-venv: $(VENV_DIR)
	@echo "✓ Python virtual environment ready"

# Validate disc files
setup-validate: $(VENV_DIR) validate-disc
	@echo "✓ Game disc validated"

# Check system dependencies
check-deps:
	@echo "Checking system dependencies..."
	@echo ""
	@missing=""; \
	for cmd in make git python3 mipsel-linux-gnu-as mipsel-linux-gnu-ld wget; do \
		if ! command -v $$cmd >/dev/null 2>&1; then \
			echo "✗ Missing: $$cmd"; \
			missing="$$missing $$cmd"; \
		else \
			echo "✓ Found: $$cmd"; \
		fi; \
	done; \
	echo ""; \
	if [ -n "$$missing" ]; then \
		echo "Missing dependencies! Install with:"; \
		echo "  sudo apt install make git python3 python3-pip python3-venv binutils-mipsel-linux-gnu wget"; \
		exit 1; \
	fi
	@echo "All basic dependencies found!"
	@echo ""
	@echo "For QEMU-IRIX (IDO 5.2), also need:"
	@echo "  sudo apt install pkg-config libglib2.0-dev flex bison"

# Fetch the optional m2c decompiler at a pinned upstream commit into ignored
# build output.  The vendored copy is not shipped in the release tree.
M2C_DIR    := build/m2c
M2C_COMMIT := c632946b8cfbe8fce442b522dba92dfa72f1f317
.PHONY: setup-m2c
setup-m2c:
	@mkdir -p "$(M2C_DIR)"; \
	if [ ! -d "$(M2C_DIR)/.git" ]; then \
		git -C "$(M2C_DIR)" init && \
		git -C "$(M2C_DIR)" remote add origin \
			https://github.com/matt-kempster/m2c || exit 1; \
	fi; \
	git -C "$(M2C_DIR)" fetch --depth 1 origin "$(M2C_COMMIT)" && \
	git -C "$(M2C_DIR)" checkout --force --detach FETCH_HEAD || exit 1
	@echo " m2c ready: $(M2C_DIR)/m2c.py (pinned $(M2C_COMMIT))"

# Fetch decomp-permuter at a pinned upstream commit into ignored build output,
# then overlay the project's compile wrapper and context headers.
PERMUTER_DIR    := build/decomp-permuter
PERMUTER_COMMIT := 8556c81d80d1c1af98a858c8f4dc951357f29139
PERMUTER_SHA256 := 57cfb45141a2f97ce27e74c1882aab162ff203c2f4688b4617fc2ec3a6ca9907
.PHONY: setup-permuter
setup-permuter:
	@set -e; \
	archive="$(PERMUTER_DIR).tar.gz"; \
	wget -q --tries=3 -O "$$archive" \
		"https://codeload.github.com/simonlindholm/decomp-permuter/tar.gz/$(PERMUTER_COMMIT)"; \
	echo "$(PERMUTER_SHA256)  $$archive" | sha256sum -c -; \
	rm -rf "$(PERMUTER_DIR)"; \
	mkdir -p "$(PERMUTER_DIR)"; \
	tar -xzf "$$archive" --strip-components=1 -C "$(PERMUTER_DIR)"; \
	rm -f "$$archive"
	@mkdir -p "$(PERMUTER_DIR)/include"; \
	cp -a tools/decomp/permuter/include/. "$(PERMUTER_DIR)/include/"; \
	cp tools/decomp/permuter/tokimeki_compile.sh \
		tools/decomp/permuter/tokimeki_settings.toml "$(PERMUTER_DIR)/"; \
	if [ -f tools/decomp/permuter/TOKIMEKI_USAGE.md ]; then \
		cp tools/decomp/permuter/TOKIMEKI_USAGE.md "$(PERMUTER_DIR)/"; fi
	@echo " decomp-permuter ready: $(PERMUTER_DIR)/permuter.py (pinned $(PERMUTER_COMMIT))"

# Build QEMU-IRIX for IDO 5.2 compiler emulation.
#
# The vendored source was removed from the release tree.  Source is fetched at
# a pinned commit into build/qemu-irix-src and built into build/qemu-irix.
# QEMU 2.11 predates GCC 14's promotion of several warnings to errors, so the
# permissive -Wno-* set below is required on a modern toolchain.
setup-qemu-irix:
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   Building QEMU-IRIX for IDO 5.2 emulation..."
	@echo "════════════════════════════════════════════════════════════════"
	@if [ -f "$(QEMU_IRIX_BIN)" ]; then \
		echo "✓ QEMU-IRIX already built: $(QEMU_IRIX_BIN)"; \
		exit 0; \
	fi
	@src="$(QEMU_IRIX_SRC)"; \
	if [ ! -d "$$src/.git" ]; then \
		mkdir -p "$$src" && \
		git -C "$$src" init && \
		git -C "$$src" remote add origin \
			https://github.com/n64decomp/qemu-irix || exit 1; \
	fi; \
	git -C "$$src" fetch --depth 1 origin "$(QEMU_IRIX_COMMIT)" && \
	git -C "$$src" checkout --detach FETCH_HEAD || exit 1; \
	echo "Source: $$src (pinned $(QEMU_IRIX_COMMIT))"; \
	chmod +x "$$src/configure" "$$src"/scripts/*.sh 2>/dev/null || true; \
	( cd "$$src" && \
	  git config submodule.ui/keycodemapdb.url https://github.com/qemu/keycodemapdb.git && \
	  git config submodule.dtc.url https://github.com/dgibson/dtc.git && \
	  git submodule update --init --depth 1 ui/keycodemapdb dtc && \
	  git submodule status dtc ui/keycodemapdb > .git-submodule-status ) || exit 1; \
	mkdir -p $(QEMU_IRIX_BUILD) && \
	( cd $(QEMU_IRIX_BUILD) && sh "$(CURDIR)/$$src/configure" \
		--target-list=irix-linux-user \
		--python=$(CURDIR)/$(VENV_DIR)/bin/python3 \
		--disable-tools --disable-system --disable-werror \
		--disable-git-update --disable-capstone \
		--extra-cflags="-Wno-implicit-function-declaration -Wno-implicit-int \
-Wno-int-conversion -Wno-incompatible-pointer-types -Wno-return-mismatch \
-Wno-error -fcommon" ) || exit 1
	@$(MAKE) -C $(QEMU_IRIX_BUILD) -j$$(nproc)
	@echo ""
	@echo "✓ QEMU-IRIX built: $(QEMU_IRIX_BIN)"

# Stage an IRIX 5.2 rootfs for qemu-irix.
#
# No IRIX install media needed: tools/ido-static-recomp/ido/5.2 already IS a
# complete rootfs (lib/libc.so.1, lib/rld, usr/lib/{cfe,uopt,ugen,as1},
# usr/bin/cc).  It is copied rather than symlinked so the executable bits can
# be set without touching the tracked tree -- those files are mode 644 in git,
# and qemu reports the resulting failure with printf()+_exit(), so the
# "Permission denied" message is LOST whenever stdout is a pipe.  A silent
# exit-1 from qemu-irix is almost always this.
setup-irix-rootfs:
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   Staging IRIX 5.2 rootfs -> $(IRIX_ROOTFS)"
	@echo "════════════════════════════════════════════════════════════════"
	@if [ ! -f "$(IDO52_IRIX_TREE)/usr/bin/cc" ]; then \
		echo "ERROR: $(IDO52_IRIX_TREE) is missing the IRIX 5.2 binaries."; \
		exit 1; \
	fi
	@rm -rf $(IRIX_ROOTFS)
	@mkdir -p $(dir $(IRIX_ROOTFS))
	@cp -rL $(IDO52_IRIX_TREE) $(IRIX_ROOTFS)
	@chmod +x $(IRIX_ROOTFS)/usr/bin/* $(IRIX_ROOTFS)/usr/lib/* $(IRIX_ROOTFS)/lib/*
	@echo "✓ IRIX rootfs ready: $(IRIX_ROOTFS)"
	@echo ""
	@echo "Smoke test:"
	@echo "  $(QEMU_IRIX_BIN) -L $(IRIX_ROOTFS) $(IRIX_ROOTFS)/usr/bin/cc \\"
	@echo "      -O2 -G0 -mips1 -EL -non_shared -c foo.c -o foo.o"
	@echo ""
	@echo "Differential validation vs our recomp:"
	@echo "  python3 tools/analysis/validate_ido52.py --corpus all --no-env"

# Full IDO 5.2 setup (static recompilation - RECOMMENDED)
# This builds the statically recompiled IDO 5.2 from tools/ido-static-recomp
setup-ido52:
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   Building IDO 5.2 compiler (static recompilation)..."
	@echo "════════════════════════════════════════════════════════════════"
	@echo ""
	@if [ -f "$(IDO52_CC)" ]; then \
		echo "IDO 5.2 already built: $(IDO52_CC)"; \
		echo "To rebuild, run: cd tools/ido-static-recomp && make clean VERSION=5.2 && make VERSION=5.2,"; \
		echo "then make setup-ido52 again (it re-applies the hook chain)"; \
	else \
		echo "Building IDO 5.2..."; \
		cd $(TOOLS_DIR)/ido-static-recomp && \
		if [ ! -f "build/recomp.elf" ]; then make setup; fi && \
		make VERSION=5.2 -j$$(nproc); \
	fi
	@echo "Applying the IDO 5.2 hook chain + gp-save fix (idempotent)..."
	python3 $(TOOLS_DIR)/ido-static-recomp/apply_all_hooks.py
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   ✓ IDO 5.2 setup complete!"
	@echo "════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "Compiler location: $(IDO52_CC)"
	@echo ""
	@echo "Usage:"
	@echo "  $(IDO52_CC) -c source.c -o source.o"
	@echo ""
	@echo "Or use: make test-decomp"
	@echo ""

# Test IDO 5.2 compiler (static recompilation)
test-ido52:
	@echo "Testing IDO 5.2 compiler (static recomp)..."
	@if [ ! -f "$(IDO52_CC)" ]; then \
		echo "ERROR: IDO 5.2 not built. Run: make setup-ido52"; \
		exit 1; \
	fi
	@echo 'int add(int a, int b) { return a + b; }' > /tmp/test_ido52.c
	@$(IDO52_CC) -c /tmp/test_ido52.c -o /tmp/test_ido52.o 2>&1
	@echo ""
	@if [ -f "/tmp/test_ido52.o" ]; then \
		echo "Output file: /tmp/test_ido52.o"; \
		file /tmp/test_ido52.o; \
		echo ""; \
		echo "Disassembly:"; \
		mips-linux-gnu-objdump -d /tmp/test_ido52.o 2>/dev/null || echo "(install mips-linux-gnu-binutils for disassembly)"; \
		echo ""; \
		echo "✓ SUCCESS! IDO 5.2 produces valid MIPS ELF output"; \
	else \
		echo "✗ FAILED: No output file produced"; \
		exit 1; \
	fi

