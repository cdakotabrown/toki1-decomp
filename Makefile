	rm -f $(BUILD_DIR)/tokimeki_rebuilt.*
	@echo "ISO assets cleaned!"

# ═══════════════════════════════════════════════════════════════════════════════
# BYTE-PERFECT BUILD (Raw .word assembly)
# ═══════════════════════════════════════════════════════════════════════════════
# This build method uses pure .word directives, guaranteeing byte-perfect
# reproduction. Use this as a baseline or when splat-based build has issues.

RAW_BUILD_DIR := $(BUILD_DIR)/raw
RAW_ASM := $(RAW_BUILD_DIR)/main.s
RAW_LD := $(RAW_BUILD_DIR)/main.ld
RAW_ELF := $(RAW_BUILD_DIR)/main.elf
RAW_BIN := $(RAW_BUILD_DIR)/SLPS_000.65.new

# ═══════════════════════════════════════════════════════════════════════════════
# C BUILD (the registered byte-perfect C, SHA1-gated)
# ═══════════════════════════════════════════════════════════════════════════════
# build-c compiles every C function registered in config/level3_functions.json
# (with its PostProc chain), patches it into the executable and requires the
# retail SHA1. It exits non-zero on any mismatch.
#
# build-c-all is the older "C-only" experiment (tools/build/build_all_c.py):
# it compiles without the PostProc chain and was never expected to match.

C_ONLY_BIN := $(BUILD_DIR)/c_only/SLPS_000.65.new

build-c: $(VENV_DIR) $(IDO_CC)
	@echo "════════════════════════════════════════"
	@echo "   C Build (registered byte-perfect C)"
	@echo "════════════════════════════════════════"
	@$(PYTHON) tools/build/build_level3_c.py

build-c-all: $(VENV_DIR) $(IDO_CC)
	@$(PYTHON) tools/build/build_all_c.py

build-c-stats: $(VENV_DIR)
	@$(PYTHON) tools/build/build_all_c.py --stats

# ═══════════════════════════════════════════════════════════════════════════════
# HYBRID BUILD (C + Assembly integration)
# ═══════════════════════════════════════════════════════════════════════════════
# This build method integrates decompiled C functions with raw assembly.
# The linker places C code at exact addresses within the executable.

HYBRID_BUILD_DIR := $(BUILD_DIR)/hybrid
HYBRID_ASM := $(HYBRID_BUILD_DIR)/main.s
HYBRID_LD := $(HYBRID_BUILD_DIR)/main.ld
HYBRID_ELF := $(HYBRID_BUILD_DIR)/main.elf
HYBRID_BIN := $(HYBRID_BUILD_DIR)/SLPS_000.65.new
DECOMP_CONFIG := config/decompiled_functions.json

# C source files for decompiled functions
# NOTE: Only include functions listed in config/decompiled_functions.json
# This prevents attempting to compile incomplete/broken functions
C_SRC := $(SRC_DIR)/main/leaf_functions.c
C_ASM := $(BUILD_DIR)/c/main/leaf_functions.s
# Generate C source list from config (only compile functions that passed size filter)
C_SOURCES := $(shell $(PYTHON) -c "import json; config = json.load(open('config/decompiled_functions.json')); print(' '.join([f'src/main/nonmatchings/{f[\"name\"]}.c' for f in config['functions']]))" 2>/dev/null || echo "")
C_OBJ := $(C_SOURCES:$(SRC_DIR)/%.c=$(BUILD_DIR)/c/%.o)

# Build using pure .word assembly (guaranteed SHA1 match)
build-raw: $(VENV_DIR)
	@echo "════════════════════════════════════════"
	@echo "   Building from raw bytes..."
	@echo "════════════════════════════════════════"
	@$(PYTHON) tools/build/build_from_bytes.py \
		--exe $(ORIGINAL_BIN) \
		--asm $(RAW_ASM) \
		--ld $(RAW_LD) \
		--elf $(RAW_ELF) \
		--bin $(RAW_BIN)

# Verify raw build
check-raw: build-raw
	@echo ""
	@echo "Verification complete!"
	@if [ "$$(sha1sum $(RAW_BIN) | awk '{print $$1}')" = "$(EXPECTED_SHA1)" ]; then \
		echo "SUCCESS! Binary matches original SHA1!"; \
	else \
		echo "ERROR: Binary SHA1 does not match!"; \
		exit 1; \
	fi

# ═══════════════════════════════════════════════════════════════════════════════
# HYBRID BUILD TARGETS (C + Assembly)
# ═══════════════════════════════════════════════════════════════════════════════

# Compile C files to object files using IDO 5.3
# IDO produces ELF objects directly, no need for intermediate assembly
$(BUILD_DIR)/c/%.o: $(SRC_DIR)/%.c $(IDO_CC)
	@mkdir -p $(dir $@)
	$(IDO_CC) $(IDO_CFLAGS) $(IDO_INCLUDES) -c $< -o $@

# Generate hybrid assembly (splits raw bytes around decompiled functions)
$(HYBRID_ASM): $(VENV_DIR) $(DECOMP_CONFIG)
	@echo "════════════════════════════════════════"
	@echo "   Generating hybrid assembly..."
	@echo "════════════════════════════════════════"
	@$(PYTHON) tools/build/build_with_c.py \
		--exe $(ORIGINAL_BIN) \
		--functions $(DECOMP_CONFIG) \
		--asm $(HYBRID_ASM) \
		--ld $(HYBRID_LD)

# Assemble hybrid assembly
$(HYBRID_BUILD_DIR)/main.o: $(HYBRID_ASM)
	@echo "Assembling hybrid assembly..."
	$(AS) -march=r3000 -o $@ $(HYBRID_ASM)

# Link hybrid build (C object files + raw assembly)
$(HYBRID_ELF): $(HYBRID_BUILD_DIR)/main.o $(C_OBJ) $(HYBRID_LD)
	@echo "Linking hybrid build..."
	$(LD) $(LDFLAGS) -T $(HYBRID_LD) -o $@ $(HYBRID_BUILD_DIR)/main.o $(C_OBJ)

# Extract hybrid binary
$(HYBRID_BIN): $(HYBRID_ELF)
	@echo "Extracting hybrid binary..."
	$(OBJCOPY) -O binary $< $@

# Build hybrid (C + assembly integration)
build-hybrid: $(HYBRID_BIN)
	@echo ""
	@echo "════════════════════════════════════════"
	@echo "   Hybrid build complete!"
	@echo "════════════════════════════════════════"
	@echo ""
	@echo "Output: $(HYBRID_BIN)"
	@echo "Size: $$(stat -c%s $(HYBRID_BIN)) bytes"
	@echo ""
	@echo "NOTE: This build includes decompiled C code."
	@echo "      It will NOT match the original SHA1 unless"
	@echo "      all C functions are byte-perfect matches."

# Patch disc with hybrid build
patch-disc-hybrid: build-hybrid
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   Patching disc with hybrid build (C + assembly)..."
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(BUILD_DIR)
	@cp "$(DISC_IMAGE)" "$(BUILD_DIR)/tokimeki_hybrid_track1.bin"
	@$(PYTHON) tools/disc/patch_cdrom.py \
		--track "$(BUILD_DIR)/tokimeki_hybrid_track1.bin" \
		--exe $(HYBRID_BIN) \
		--start-sector $(EXE_START_SECTOR)
	@cp "disks/Tokimeki Memorial - Forever with You (Japan) (Rev 1) (Track 2).bin" \
	   "$(BUILD_DIR)/tokimeki_hybrid_track2.bin"
	@echo 'FILE "tokimeki_hybrid_track1.bin" BINARY' > $(BUILD_DIR)/tokimeki_hybrid.cue
	@echo '  TRACK 01 MODE2/2352' >> $(BUILD_DIR)/tokimeki_hybrid.cue
	@echo '    FLAGS DCP' >> $(BUILD_DIR)/tokimeki_hybrid.cue
	@echo '    INDEX 01 00:00:00' >> $(BUILD_DIR)/tokimeki_hybrid.cue
	@echo 'FILE "tokimeki_hybrid_track2.bin" BINARY' >> $(BUILD_DIR)/tokimeki_hybrid.cue
	@echo '  TRACK 02 AUDIO' >> $(BUILD_DIR)/tokimeki_hybrid.cue
	@echo '    FLAGS DCP' >> $(BUILD_DIR)/tokimeki_hybrid.cue
	@echo '    INDEX 00 00:00:00' >> $(BUILD_DIR)/tokimeki_hybrid.cue
	@echo '    INDEX 01 00:02:00' >> $(BUILD_DIR)/tokimeki_hybrid.cue
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   Disc patched with hybrid build!"
	@echo "════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "To test in emulator:"
	@echo "  (open in a PS1 emulator) $(BUILD_DIR)/tokimeki_hybrid.cue"

# Patch executable into disc for emulator testing (SLPS-00065)
# The executable is at sector 24 in Mode 2 Form 1 format.
#
# CD-ROM Mode 2 Form 1 sector structure (2352 bytes):
#   - Bytes 0-11:    Sync pattern (12 bytes)
#   - Bytes 12-15:   Header (4 bytes)
#   - Bytes 16-23:   Subheader (8 bytes)
#   - Bytes 24-2071: User data (2048 bytes) <-- executable goes here
#   - Bytes 2072-2351: EDC/ECC (280 bytes)
#
# We CANNOT simply dd the executable - we must preserve sector headers!

patch-disc: build-raw
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   Patching executable into disc (SLPS-00065)..."
	@echo "════════════════════════════════════════════════════════════════"
	@echo ""
	@mkdir -p $(BUILD_DIR)
	@echo "  Copying Track 1 (data track)..."
	@cp "$(DISC_IMAGE)" "$(BUILD_DIR)/tokimeki_patched_track1.bin"
	@echo "  Patching executable at sector $(EXE_START_SECTOR)..."
	@$(PYTHON) tools/disc/patch_cdrom.py \
		--track "$(BUILD_DIR)/tokimeki_patched_track1.bin" \
		--exe $(RAW_BIN) \
		--start-sector $(EXE_START_SECTOR)
	@echo ""
	@echo "  Copying Track 2 (audio track)..."
	@cp "disks/Tokimeki Memorial - Forever with You (Japan) (Rev 1) (Track 2).bin" \
	   "$(BUILD_DIR)/tokimeki_patched_track2.bin"
	@echo "  Creating CUE file..."
	@echo 'FILE "tokimeki_patched_track1.bin" BINARY' > $(BUILD_DIR)/tokimeki_patched.cue
	@echo '  TRACK 01 MODE2/2352' >> $(BUILD_DIR)/tokimeki_patched.cue
	@echo '    FLAGS DCP' >> $(BUILD_DIR)/tokimeki_patched.cue
	@echo '    INDEX 01 00:00:00' >> $(BUILD_DIR)/tokimeki_patched.cue
	@echo 'FILE "tokimeki_patched_track2.bin" BINARY' >> $(BUILD_DIR)/tokimeki_patched.cue
	@echo '  TRACK 02 AUDIO' >> $(BUILD_DIR)/tokimeki_patched.cue
	@echo '    FLAGS DCP' >> $(BUILD_DIR)/tokimeki_patched.cue
	@echo '    INDEX 00 00:00:00' >> $(BUILD_DIR)/tokimeki_patched.cue
	@echo '    INDEX 01 00:02:00' >> $(BUILD_DIR)/tokimeki_patched.cue
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   Disc patched successfully!"
	@echo "════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Track 1 (data):  $(BUILD_DIR)/tokimeki_patched_track1.bin"
	@echo "  Track 2 (audio): $(BUILD_DIR)/tokimeki_patched_track2.bin"
	@echo "  CUE file:        $(BUILD_DIR)/tokimeki_patched.cue"
	@echo ""
	@echo "To test in emulator:"
	@echo "  (open in a PS1 emulator) $(BUILD_DIR)/tokimeki_patched.cue"
	@echo "  OR open $(BUILD_DIR)/tokimeki_patched.cue in your PS1 emulator"

# Test the ORIGINAL disc (no patching) to verify disc image works
test-original-disc:
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   Creating test disc from ORIGINAL (no patches)..."
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(BUILD_DIR)/test
