VERSION ?= jp
VENV_DIR := .venv
PYTHON := $(VENV_DIR)/bin/python3
# Use custom wrapper that sets MIPS1 arch level for PS1
SPLAT := $(PYTHON) tools/build/run_splat.py

# Directories
SRC_DIR := src
ASM_DIR := asm/$(VERSION)
BUILD_DIR := build/$(VERSION)
CONFIG_DIR := config
TOOLS_DIR := tools
BIN_DIR := tools/psyq-gcc-260
INCLUDE_DIR := include

# Tools
CROSS := mipsel-linux-gnu-
AS := $(CROSS)as
LD := $(CROSS)ld
OBJCOPY := $(CROSS)objcopy

# IDO Compiler Setup
# ===================
# The game code was compiled with IDO 5.2 (ECOFF 3.18); the Sony library
# region mixes IDO and Psy-Q GCC.
#
# Available compilers (all in tools/ido-static-recomp):
#   - IDO 5.2: the compiler the build uses (it reproduces the retail bytes)
#   - IDO 5.3: Alternative for comparison, produces ECOFF 3.19
#
# IDO 5.2 static recompilation was fixed in January 2026 by extracting
# correct libc symbol addresses from IRIX 5.2's libc.so.1.
#
# Build the compilers:
#   cd tools/ido-static-recomp
#   make setup              # One-time: build recomp tool
#   make VERSION=5.2 -j4    # Build IDO 5.2 (recommended)
#   (only IDO 5.2 is vendored: make VERSION=5.2 -j4)

# IDO 5.2 - RECOMMENDED - Exact compiler used for Tokimeki Memorial (ALL regions)
IDO52_DIR := $(TOOLS_DIR)/ido-static-recomp/build/5.2/out
IDO52_CC := $(IDO52_DIR)/cc
IDO52_CFE := $(IDO52_DIR)/cfe
IDO52_UGEN := $(IDO52_DIR)/ugen
IDO52_UOPT := $(IDO52_DIR)/uopt
IDO52_AS1 := $(IDO52_DIR)/as1

# IDO 5.3 - Alternative compiler (produces slightly different output)
IDO53_DIR := $(TOOLS_DIR)/ido-static-recomp/build/5.3/out
IDO53_CC := $(IDO53_DIR)/cc

# Default compiler: IDO 5.2 (the correct one for this game)
IDO_CC := $(IDO52_CC)

# Compiler flags for IDO (PS1 little-endian MIPS I)
# -EL: Little-endian output (PS1 requirement)
# -G0: No GP-relative addressing
# -mips1: MIPS I instruction set (R3000)
# -O2: Optimization level 2 (matches original)
# -non_shared: Disable PIC (position-independent code) - direct calls
IDO_CFLAGS := -EL -G0 -mips1 -O2 -non_shared
IDO_INCLUDES := -I$(INCLUDE_DIR) -Iinclude

# Assembly flags for GNU AS (unchanged)
ASFLAGS := -march=r3000 -O1 -G0 -Iinclude

# Legacy PSY-Q GCC (kept for reference, not used)
CC1PSX := $(BIN_DIR)/cc1-psx-26
CPP := cpp
CPPFLAGS := -I$(INCLUDE_DIR) -Iinclude -undef -Wall -lang-c -fno-builtin -gstabs -g
CFLAGS := -G0 -O2 -funsigned-char -fpeephole -ffunction-cse -fpcc-struct-return -fcommon -fverbose-asm -msoft-float

# Linker flags to define external symbols
# Generate ALL 916 function symbols from function_map.json
# This allows C code to call any function and the linker will resolve it correctly
FUNCTION_SYMBOLS := $(shell python3 tools/build/generate_ld_symbols.py 2>/dev/null || echo "")

LDFLAGS := $(FUNCTION_SYMBOLS) \
           --defsym=func_8009CCF4=0x8009CCF4 \
           --defsym=D_800E6644=0x800E6644 \
           --defsym=D_800E667C=0x800E667C \
           --defsym=D_800E66B4=0x800E66B4 \
           --defsym=D_800E66EC=0x800E66EC \
           --defsym=D_800E6724=0x800E6724 \
           --defsym=D_800E71EE=0x800E71EE \
           --defsym=g_StructArrayPtr=0x80128A9C \
           --defsym=__main=0x80000000 \
           --noinhibit-exec

# Assembly object files - we'll find them after extraction
# Note: All function and data assembly files are generated by splat
# The linker script references them as build/jp/asm/jp/main/*.s.o

# Linker script
LD_SCRIPT := $(BUILD_DIR)/main.ld

# Target binary (SLPS-00065 - Original 1995 Japan release)
TARGET_ELF := $(BUILD_DIR)/main.elf
TARGET_BIN := $(BUILD_DIR)/SLPS_000.65.new
ORIGINAL_BIN := disks/SLPS_000.65

# Debug symbols file (contains original function/variable names!)
OBIN_FILE := disks/o.bin

# Expected SHA1 (SLPS-00065 original 1995 release)
EXPECTED_SHA1 := 2d8d474816e4bf937b09dc3b017f550f7ce4e14b

# Disc image information (SLPS-00065)
# PSX.EXE: sector 24, size 690176
# O.BIN: sector 38474, size 196608 (in CDROM/EXEDIR/)
EXE_START_SECTOR := 24
EXE_SIZE := 690176
OBIN_START_SECTOR := 38474
OBIN_SIZE := 196608

# ISO Building Tools and Paths
DUMPSXISO := $(TOOLS_DIR)/psxiso/dumpsxiso
MKPSXISO := $(TOOLS_DIR)/psxiso/mkpsxiso
ASSETS_DIR := assets
EXTRACTED_ISO_DIR := $(ASSETS_DIR)/extracted_iso
# mkpsxiso layout file. By default we use the layout generated by `make extract-assets`.
# You can override on the command line: `make rebuild-iso ISO_CONFIG=path/to/layout.xml`.
ISO_CONFIG := $(EXTRACTED_ISO_DIR)/layout.xml
ISO_OUTPUT := $(BUILD_DIR)/tokimeki_rebuilt.bin
CUE_OUTPUT := $(BUILD_DIR)/tokimeki_rebuilt.cue
DISC_IMAGE := disks/Tokimeki Memorial - Forever with You (Japan) (Rev 1) (Track 1).bin

all: check

# Setup Python environment
$(VENV_DIR):
	@echo "Setting up Python virtual environment..."
	python3 -m venv $(VENV_DIR)
	$(VENV_DIR)/bin/pip install -q -r $(TOOLS_DIR)/requirements-python.txt
	@echo "Python environment ready!"

# Check IDO compiler is present (built from ido-static-recomp)
$(IDO_CC):
	@if [ ! -f "$(IDO_CC)" ]; then \
		echo ""; \
		echo "ERROR: IDO 5.2 compiler not found!"; \
		echo ""; \
		echo "The game was compiled with IDO 5.2 (ECOFF 3.18)."; \
		echo ""; \
		echo "Build IDO 5.2 (recommended):"; \
		echo "  cd tools/ido-static-recomp"; \
		echo "  make setup         # One-time: build recomp tool"; \
		echo "  make VERSION=5.2   # Build IDO 5.2 compiler"; \
		echo ""; \
		echo "Or use 'make setup-ido52' from project root."; \
		echo ""; \
		exit 1; \
	fi
	@echo "IDO 5.2 compiler found: $(IDO_CC)"

# Legacy PSY-Q GCC cc1 (vendored in tools/psyq-gcc-260/)
$(CC1PSX):
	@echo "ERROR: cc1-psx-26 not found at $(CC1PSX)"
	@echo "It should be vendored in tools/psyq-gcc-260/"
	@exit 1

# Extract executable from disc image (SLPS-00065)
# The executable (PSX.EXE/SLPS_000.65) is at sector 24, size 690176 bytes
# The debug symbols (O.BIN) are at sector 38474, size 196608 bytes
extract-exe:
	@if [ -f "$(ORIGINAL_BIN)" ]; then \
		echo "Executable already exists: $(ORIGINAL_BIN)"; \
	elif [ -f "$(DISC_IMAGE)" ]; then \
		echo "Extracting SLPS_000.65 from disc image..."; \
		$(PYTHON) tools/iso/extract_sectors.py "$(DISC_IMAGE)" $(EXE_START_SECTOR) $(EXE_SIZE) $(ORIGINAL_BIN); \
	else \
		echo "ERROR: No disc image found to extract from"; \
		echo "  Expected: $(DISC_IMAGE)"; \
		exit 1; \
	fi

# Extract O.BIN debug symbols (contains original function/variable names)
extract-obin:
	@if [ -f "$(OBIN_FILE)" ]; then \
		echo "Debug symbols already exist: $(OBIN_FILE)"; \
	elif [ -f "$(DISC_IMAGE)" ]; then \
		echo "Extracting o.bin debug symbols from disc image..."; \
		$(PYTHON) tools/iso/extract_sectors.py "$(DISC_IMAGE)" $(OBIN_START_SECTOR) $(OBIN_SIZE) $(OBIN_FILE); \
	else \
		echo "ERROR: No disc image found to extract from"; \
		echo "  Expected: $(DISC_IMAGE)"; \
		exit 1; \
	fi

# Validate disc files before extraction
validate-disc:
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   Validating game disc files (SLPS-00065)..."
	@echo "════════════════════════════════════════════════════════════════"
	@echo ""
	@# Auto-extract executable if disc image exists but exe doesn't
	@if [ ! -f "$(ORIGINAL_BIN)" ] && [ -f "$(DISC_IMAGE)" ]; then \
		echo "Executable not found, extracting from disc image..."; \
		$(MAKE) extract-exe; \
		echo ""; \
	fi
	@if [ ! -f "$(ORIGINAL_BIN)" ]; then \
		echo "ERROR: Game executable not found!"; \
		echo ""; \
		echo "  Expected: $(ORIGINAL_BIN)"; \
		echo "  Required: SLPS-00065 (Original Japan 1995 release)"; \
		echo ""; \
		echo "Please place disc image in disks/ or extract SLPS_000.65 manually."; \
		echo "See README.md for instructions."; \
		echo ""; \
		exit 1; \
	fi
	@echo "✓ Game executable found: $(ORIGINAL_BIN)"
	@echo ""
	@echo "Checking SHA1 checksum..."
	@ACTUAL_SHA1=$$(sha1sum $(ORIGINAL_BIN) | awk '{print $$1}'); \
	if [ "$$ACTUAL_SHA1" != "$(EXPECTED_SHA1)" ]; then \
		echo ""; \
		echo "ERROR: SHA1 checksum mismatch!"; \
		echo ""; \
		echo "  Expected: $(EXPECTED_SHA1)"; \
		echo "  Got:      $$ACTUAL_SHA1"; \
		echo ""; \
		echo "You have the WRONG version of the game!"; \
		echo ""; \
		echo "Required version:"; \
		echo "  Product Code: SLPS-00065"; \
		echo "  Region: Japan"; \
		echo "  Release: Original (December 1995)"; \
		echo "  Size: 690,176 bytes (674 KB)"; \
		echo ""; \
		echo "Common mistakes:"; \
		echo "  - SLPM-86.053 (PlayStation the Best 1997) - WRONG"; \
		echo "  - SLUS/SLES (US/EU releases) - WRONG"; \
		echo "  - Modified/patched disc - WRONG"; \
		echo ""; \
		echo "Please obtain the correct disc image and try again."; \
		echo ""; \
		exit 1; \
	fi
	@echo "✓ SHA1 checksum valid: $(EXPECTED_SHA1)"
	@echo ""
	@if [ ! -f "$(DISC_IMAGE)" ]; then \
		echo "⚠ WARNING: Disc image not found (optional for building)"; \
		echo "  File: $(DISC_IMAGE)"; \
		echo "  Note: Required for 'make patch-disc' to create bootable images"; \
		echo ""; \
	else \
		echo "✓ Disc image found: $(DISC_IMAGE)"; \
		echo ""; \
	fi
	@echo "════════════════════════════════════════════════════════════════"
	@echo "   Disc validation complete!"
	@echo "════════════════════════════════════════════════════════════════"
	@echo ""

# Extract assets and run splat
extract: $(VENV_DIR) validate-disc
	@echo "Running splat to disassemble game executable..."
	$(SPLAT) $(CONFIG_DIR)/splat.$(VERSION).main.yaml
	@echo "Fixing MIPS III/IV instructions for PS1 (MIPS I)..."
	$(PYTHON) tools/build/fix_asm.py $(ASM_DIR)/main
	@echo "Creating header assembly file..."
	@dd if=$(ORIGINAL_BIN) of=$(ASM_DIR)/main/header.bin bs=1 count=2048 2>/dev/null
	@echo ".section .data" > $(ASM_DIR)/main/header.s
	@echo '.incbin "$(ASM_DIR)/main/header.bin"' >> $(ASM_DIR)/main/header.s
	@echo "Extraction complete! Linker script generated by splat."

# Assemble all .s files generated by splat
# This creates .s.o files from .s files
assemble: extract
	@echo "Assembling all splat-generated files..."
	@mkdir -p $(BUILD_DIR)/asm/$(VERSION)/main
	@mkdir -p $(BUILD_DIR)/asm/$(VERSION)/main/data
	@for f in $(ASM_DIR)/main/*.s; do \
		out=$(BUILD_DIR)/asm/$(VERSION)/main/$$(basename $$f).o; \
		echo "  Assembling $$(basename $$f)..."; \
		$(AS) $(ASFLAGS) -o $$out $$f || exit 1; \
	done
	@for f in $(ASM_DIR)/main/data/*.s; do \
		out=$(BUILD_DIR)/asm/$(VERSION)/main/data/$$(basename $$f).o; \
		echo "  Assembling data/$$(basename $$f)..."; \
		$(AS) $(ASFLAGS) -o $$out $$f || exit 1; \
	done
	@echo "Assembly complete!"

# Link everything together using splat-generated linker script
# The linker script already contains the correct list of object files in order
$(TARGET_ELF): assemble $(LD_SCRIPT)
	@echo "Linking..."
	$(LD) $(LDFLAGS) -o $@ -Map $(BUILD_DIR)/main.map -T $(LD_SCRIPT)
	@echo "Link complete!"

# Extract binary from ELF
$(TARGET_BIN): $(TARGET_ELF)
	@echo "Extracting binary..."
	$(OBJCOPY) -O binary $< $@
	@echo "Binary extracted!"

# Build everything
build: $(TARGET_BIN)
	@echo ""
	@echo "════════════════════════════════════════"
	@echo "           BUILD COMPLETE!"
	@echo "════════════════════════════════════════"
	@echo ""
	@echo "Comparing checksums..."
	@echo ""
	@echo "Original:"
	@sha1sum $(ORIGINAL_BIN)
	@echo ""
	@echo "Rebuilt:"
	@sha1sum $(TARGET_BIN)
	@echo ""
	@if [ "$$(sha1sum $(TARGET_BIN) | awk '{print $$1}')" = "$(EXPECTED_SHA1)" ]; then \
		echo "✓ SUCCESS! Binary matches original SHA1!"; \
		echo ""; \
	else \
		echo "✗ WARNING: Binary SHA1 does not match!"; \
		echo "Expected: $(EXPECTED_SHA1)"; \
		echo "Got:      $$(sha1sum $(TARGET_BIN) | awk '{print $$1}')"; \
		echo ""; \
	fi

# Verify checksums
check: build
	@echo "Verification complete!"

# Clean build artifacts
clean:
	@echo "Cleaning build artifacts..."
	rm -rf $(BUILD_DIR)
	rm -rf $(ASM_DIR)
	rm -rf assets/
	@echo "Clean complete!"

# Format source code
format: $(VENV_DIR)
	@find $(SRC_DIR) $(INCLUDE_DIR) -name '*.c' -o -name '*.h' 2>/dev/null | xargs clang-format -i || true

# Test decompiled functions using IDO 5.3 compiler
test-decomp: $(IDO_CC)
	@echo "Testing decompiled functions with IDO 5.3..."
	@mkdir -p $(BUILD_DIR)/test
	$(IDO_CC) $(IDO_CFLAGS) $(IDO_INCLUDES) -c $(SRC_DIR)/main/leaf_functions.c -o $(BUILD_DIR)/test/leaf_functions.o
	@echo ""
	@echo "Decompiled functions compile successfully with IDO!"
	@echo ""
	@echo "Disassembly of compiled functions:"
	@mipsel-linux-gnu-objdump -d $(BUILD_DIR)/test/leaf_functions.o | head -60
	@echo ""
	@echo "Generated files:"
	@ls -la $(BUILD_DIR)/test/

# Help
