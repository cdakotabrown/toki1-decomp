	@echo "  make check-raw              assemble from asm/, verify the retail SHA-1"
	@echo "  make build-c                compile the matched C, verify the same SHA-1"
	@echo "  make check-exn-all          clean-build all 26 overlays, SHA-1 gated"
	@echo "  make check-clean-main       clean-build the executable, SHA-1 gated"
	@echo "  make clean-iso              the full disc from the clean builds"
	@echo "Single function / overlay:"
	@echo "  make verify-func FUNC=name"
	@echo "  make test-overlay-match OVERLAY=X FUNC=name"
	@echo "  make check-exn OVERLAY=X"
	@echo "Other: validate-disc, patch-disc, setup-permuter, setup-m2c,"
	@echo "       setup-qemu-irix, setup-irix-rootfs, clean.  README.md has the rest."

